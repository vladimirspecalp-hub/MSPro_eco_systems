// TODO: Реализовать модуль после подключения Supabase и API.

import { createClient, SupabaseClient } from '@supabase/supabase-js';
import type { Lead, LeadRow, LeadInsert, LeadUpdate } from '@shared/types';
import { leadRowToLead, leadToLeadInsert } from '@shared/types';

type Database = {
  public: {
    Tables: {
      leads: {
        Row: LeadRow;
        Insert: LeadInsert;
        Update: LeadUpdate;
      };
      seo_pages: {
        Row: any;
        Insert: any;
        Update: any;
      };
    };
  };
};

const SUPABASE_URL = process.env.SUPABASE_URL || '';
const SUPABASE_KEY = process.env.SUPABASE_KEY || '';

let supabaseClient: SupabaseClient<Database> | null = null;

export function getSupabaseClient() {
  if (!SUPABASE_URL || !SUPABASE_KEY) {
    console.warn('Supabase credentials not configured');
    return null;
  }

  if (!supabaseClient) {
    supabaseClient = createClient<Database>(SUPABASE_URL, SUPABASE_KEY);
  }

  return supabaseClient;
}

export async function queryLeads(): Promise<Lead[]> {
  const client = getSupabaseClient();
  if (!client) return [];

  try {
    const { data, error } = await client
      .from('leads')
      .select('*')
      .order('created_at', { ascending: false });

    if (error) throw error;
    return (data || []).map(leadRowToLead);
  } catch (error) {
    console.error('Failed to query leads:', error);
    return [];
  }
}

export async function insertLead(lead: Omit<Lead, 'id' | 'createdAt' | 'updatedAt'>): Promise<Lead> {
  const client = getSupabaseClient();
  if (!client) throw new Error('Supabase not configured');

  try {
    const insertData = leadToLeadInsert(lead);
    const { data, error } = await client
      .from('leads')
      .insert(insertData as any)
      .select()
      .single();

    if (error) throw error;
    return leadRowToLead(data);
  } catch (error) {
    console.error('Failed to insert lead:', error);
    throw error;
  }
}

export async function updateLead(id: string, updates: Partial<Omit<Lead, 'id' | 'createdAt' | 'updatedAt'>>): Promise<Lead> {
  const client = getSupabaseClient();
  if (!client) throw new Error('Supabase not configured');

  try {
    const updateData: LeadUpdate = {
      name: updates.name,
      phone: updates.phone,
      email: updates.email,
      service: updates.service,
      message: updates.message,
      status: updates.status,
    };

    const { data, error } = await client
      .from('leads')
      .update(updateData as any)
      .eq('id', id)
      .select()
      .single();

    if (error) throw error;
    return leadRowToLead(data);
  } catch (error) {
    console.error('Failed to update lead:', error);
    throw error;
  }
}

export async function querySEOPages() {
  const client = getSupabaseClient();
  if (!client) return [];

  try {
    const { data, error } = await client
      .from('seo_pages')
      .select('*');

    if (error) throw error;
    return data || [];
  } catch (error) {
    console.error('Failed to query SEO pages:', error);
    return [];
  }
}
