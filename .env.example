# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mspro_ecosystems

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# OpenAI (AEO Smart Generator)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# GitHub Integration
GITHUB_PERSONAL_ACCESS_TOKEN=your-github-token-here
GITHUB_TOKEN=your-github-token-here

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Application
NODE_ENV=development
PORT=5000

# Analytics (all optional)
VITE_ANALYTICS_ENABLED=0
VITE_ANALYTICS_DEBUG=1
VITE_GTM_ID=
VITE_GA_TAG_ID=
VITE_YM_TAG_ID=
VITE_HOTJAR_ID=
VITE_CALLTRACKING_KEY=
VITE_AB_TEST_KEY=

# News Module
NEWS_INGEST_SECRET=your-news-ingest-secret
NEWS_ADMIN_SECRET=your-admin-secret
SITE_URL=https://mspro-ltd.ru
NEWS_CANONICAL_BASE=/news
